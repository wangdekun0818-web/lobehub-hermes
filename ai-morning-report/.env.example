# LobeHub 早报投递 API（复制到 ~/.hermes/.env 或 export）

# API 服务
LOBEHUB_DELIVER_API_HOST=127.0.0.1
LOBEHUB_DELIVER_API_PORT=8765
# LOBEHUB_DELIVER_API_KEY=your-secret-key

# 默认投递目标（聊天页 URL 参数）
LOBEHUB_BASE_URL=http://127.0.0.1:3010
LOBEHUB_SESSION_ID=inbox
LOBEHUB_TOPIC_ID=NHODLDqg

# 助手消息元数据
LOBEHUB_DELIVER_MODEL=gpt-5.4
LOBEHUB_DELIVER_PROVIDER=openai

# agent-browser 会话名（需本机已安装 agent-browser）
LOBEHUB_BROWSER_SESSION=lobehub-deliver

# 成稿目录（默认 ~/.hermes/workspace/ai-morning-report/memory）
# AI_MORNING_REPORT_MEMORY_DIR=
